#!/bin/bash

set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
test_root="$(mktemp -d /tmp/fire-tv-remote-test.XXXXXX)"
trap 'rm -r -- "$test_root"' EXIT

mkdir -p "$test_root/io.github.ypmrg.fire-tv-remote/venv/bin"
ln -s "$repo_root/tests/fake-python" \
  "$test_root/io.github.ypmrg.fire-tv-remote/venv/bin/python"

mapfile -t arguments < <(
  XDG_DATA_HOME="$test_root" \
    FIRE_TV_HOST="192.168.9.9:5555" \
    FIRE_TV_NAME="Unconfigured Fire TV" \
    "$repo_root/fire-tv-remote" session
)

[[ ${arguments[0]} == "$repo_root/fire-tv-remote-session.py" ]]
[[ ${arguments[1]} == "--host" ]]
[[ ${arguments[2]} == "192.168.9.9:5555" ]]
[[ ${arguments[3]} == "--name" ]]
[[ ${arguments[4]} == "Unconfigured Fire TV" ]]

python3 - "$repo_root" <<'PY'
import ipaddress
import json
import re
import shlex
import sys
from pathlib import Path

root = Path(sys.argv[1])
source = (root / "fire-tv-remote-session.py").read_text(encoding="utf-8")

start = source.index("def normalize_host(")
end = source.index("\ndef host_key(")
ns = {"re": re, "DEFAULT_ADB_PORT": 5555}
exec(source[start:end], ns)
normalize_host = ns["normalize_host"]
assert normalize_host("192.168.1.10") == ("192.168.1.10", 5555)
assert normalize_host("192.168.1.10:5556") == ("192.168.1.10", 5556)
assert normalize_host("firetv.local:5555") == ("firetv.local", 5555)
assert normalize_host("[fe80::1]:5555") == ("fe80::1", 5555)

avahi_start = source.index("def decode_avahi_value(")
avahi_end = source.index("\n\nclass RemoteSession", avahi_start)
avahi_ns = {
    "ipaddress": ipaddress,
    "re": re,
    "shlex": shlex,
    "DEFAULT_ADB_PORT": 5555,
    "host_key": lambda address, port: f"{address}:{port}",
}
exec(source[avahi_start:avahi_end], avahi_ns)
avahi_output = r'''=;wlan0;IPv4;amzn\.dmgr\058device;_amzn-wplay._tcp;local;android-home.local;192.168.1.147;37343;"a=0" "n=Matthieu's Fire TV" "tr=tcp"'''
records = avahi_ns["parse_avahi_records"](
    avahi_output,
    "_amzn-wplay._tcp",
)
assert records == [{
    "name": "Matthieu's Fire TV",
    "host": "192.168.1.147:5555",
    "address": "192.168.1.147",
    "port": "5555",
}]

rich_name_output = (
    r'=;wlan0;IPv4;device;_amzn-wplay._tcp;local;bad.local;'
    r'192.168.1.148;37343;"n=<img src=https://example.test/pixel>"'
)
rich_name_records = avahi_ns["parse_avahi_records"](
    rich_name_output,
    "_amzn-wplay._tcp",
)
assert rich_name_records[0]["name"] == "<img src=https://example.test/pixel>"

malicious_output = (
    r'=;wlan0;IPv4;device;_amzn-wplay._tcp;local;bad.local;'
    r'<img src=https://example.test/pixel>;37343;"n=Bad TV"'
)
assert avahi_ns["parse_avahi_records"](
    malicious_output,
    "_amzn-wplay._tcp",
) == []


assert "process.communicate()" not in source
assert "process.stdout.readexactly(AVAHI_OUTPUT_LIMIT_BYTES + 1)" in source

apps_start = source.index("APP_PACKAGES")
apps_end = source.index("}", apps_start) + 1
# Only the four UI apps should ship.
assert '"netflix"' in source[apps_start:apps_end]
assert '"prime"' in source[apps_start:apps_end]
assert '"disney"' in source[apps_start:apps_end]
assert '"youtube"' in source[apps_start:apps_end]
assert '"twitch"' not in source[apps_start:apps_end]

manifest = json.loads((root / "manifest.json").read_text(encoding="utf-8"))
assert manifest["schemaVersion"] == 1
assert manifest["id"] == "io.github.ypmrg.fire-tv-remote"
assert manifest["version"] == "1.0.2"
readme = (root / "README.md").read_text(encoding="utf-8")
assert "Thomas Evans" in readme
assert "omarchy-apple-tv-remote" in readme
assert "ADB debugging" in readme
assert "github.com/ypMrg/omarchy-fire-tv-stick-remote.git" in readme
assert "github.com/MatthieuGC/" not in readme
assert (root / "Widget.qml").is_file()
for logo_name in ("netflix.svg", "prime.svg", "disney.svg", "youtube.svg"):
    logo_path = root / "assets" / logo_name
    assert logo_path.is_file()
    logo = logo_path.read_text(encoding="utf-8").lower()
    # Official dark brand fills vanish on dark themes. Wordmarks must be
    # light/monochrome so QML can tint them with the theme foreground.
    assert "#01147c" not in logo
    assert "#232f3e" not in logo
    assert "#d81f26" not in logo

icon = (root / "assets" / "remote.svg").read_text(encoding="utf-8")
assert 'xmlns="http://www.w3.org/2000/svg"' in icon
assert 'viewBox="0 0 24 24"' in icon
assert 'fill="none"' in icon
assert 'stroke="#ffffff"' in icon.lower()
assert "<script" not in icon.lower()
assert "currentColor" not in icon

widget = (root / "Widget.qml").read_text(encoding="utf-8")
assert "readonly property int panelHorizontalMargin" in widget
assert "width: Math.max(0, scroll.width - root.panelHorizontalMargin * 2)" in widget
assert "root.equalKeyWidth(remoteView.width, 3)" in widget
assert 'property string pressedAction: ""' in widget
assert "root.pressedAction === action" in widget
assert "component PlatformKey" not in widget
assert "Math.round(keyWidth * 0.48)" not in widget
assert "radius: Style.cornerRadius" in widget
assert "property string logo: \"\"" in widget
assert "import QtQuick.Effects" in widget
assert "colorization: 1.0" in widget
assert "colorizationColor: root.foreground" in widget
assert "brand:" not in widget
assert "autoDetectButton" not in widget
assert "autoDetectHost" not in widget
assert "fillHostOnScan" not in widget
assert "applyDetectedHost(devices)" in widget
assert r'text: "Authorize ADB for\n"' in widget
assert r'text: "Authorize ADB for\\n"' not in widget
assert "useActiveColor: false" in widget
assert 'text: root.viewMode === "remote" ? "FIRE TV REMOTE"' not in widget
assert "FIRE TV DEVICES" not in widget
assert "contentColumn.width * 0.45" not in widget
assert "contentColumn.width * 0.38" not in widget
assert "readonly property color onlineColor" in widget
assert "readonly property color offlineColor" in widget
assert "readonly property string statusHeadline" in widget
assert "readonly property string statusDetail" in widget
assert "component RemoteIcon" in widget
assert 'Qt.resolvedUrl("assets/remote.svg")' in widget
assert "iconComponent:" in widget
assert "id: deviceButton" in widget
assert "+ String(modelData.name).toUpperCase()" in widget
assert 'tooltipText: "Fire TV Remote"' in widget
assert widget.count("textFormat: Text.PlainText") >= 6
assert "󰑩" not in widget
print("helpers + assets + app allowlist ok")
PY

# Wrapper rejects unknown app ids
if "$repo_root/fire-tv-remote" app-youtube 2>/dev/null; then
  echo "expected app-youtube to fail" >&2
  exit 1
fi

echo "Session starts even when the preferred Fire TV host is unreachable."
